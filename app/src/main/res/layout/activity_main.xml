<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_orienta_screen">

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RIASEC EXPLORER"
                android:textAppearance="@style/TextAppearance.Orienta.Overline" />

            <TextView
                android:id="@+id/tvGreeting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Discover your interests"
                android:textAppearance="@style/TextAppearance.Orienta.Display" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Take the 48-item RIASEC assessment, understand your Holland code and explore your Top-3 compatible domains."
                android:textAppearance="@style/TextAppearance.Orienta.Subtitle" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:background="@drawable/bg_orienta_glass_card_accent"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RIASEC INTERESTS"
                    android:textAppearance="@style/TextAppearance.Orienta.Overline" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Find the work environments that fit you"
                    android:textAppearance="@style/TextAppearance.Orienta.Title" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="48 questions • about 6 minutes • 6 RIASEC dimensions"
                    android:textAppearance="@style/TextAppearance.Orienta.Caption" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStartRiasec"
                    style="@style/Widget.Orienta.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/orienta_button_height"
                    android:layout_marginTop="20dp"
                    android:text="Start RIASEC Test" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_orienta_glass_card"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PROFILE"
                    android:textAppearance="@style/TextAppearance.Orienta.Overline" />

                <TextView
                    android:id="@+id/tvProfileSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Add your name, last name and email in Profile."
                    android:textAppearance="@style/TextAppearance.Orienta.Body" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnProfile"
                    style="@style/Widget.Orienta.Button.Glass"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/orienta_button_height"
                    android:layout_marginTop="18dp"
                    android:text="Open Profile" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_orienta_glass_card"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LAST RESULT"
                    android:textAppearance="@style/TextAppearance.Orienta.Overline" />

                <TextView
                    android:id="@+id/tvLastResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Complete the test to see your results."
                    android:textAppearance="@style/TextAppearance.Orienta.Body" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnViewResult"
                    style="@style/Widget.Orienta.Button.Glass"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/orienta_button_height"
                    android:layout_marginTop="18dp"
                    android:text="View Last Result"
                    android:visibility="gone" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogout"
                style="@style/Widget.Orienta.Button.Glass"
                android:layout_width="match_parent"
                android:layout_height="@dimen/orienta_button_height"
                android:layout_marginTop="18dp"
                android:text="Log Out" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="24dp"
                android:text="RIASEC measures vocational interests. Use the result as an exploration tool rather than a single fixed answer about your future."
                android:textAppearance="@style/TextAppearance.Orienta.Caption"
                android:textColor="@color/orienta_text_secondary" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
