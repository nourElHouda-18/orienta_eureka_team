<?xml version="1.0" encoding="utf-8"?>
<!-- Horizontal progress: glass track with a teal -> blue gradient fill. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/orienta_glass_fill_strong" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <gradient
                    android:angle="0"
                    android:endColor="@color/orienta_blue"
                    android:startColor="@color/orienta_teal" />
                <corners android:radius="8dp" />
            </shape>
        </clip>
    </item>
</layer-list>
