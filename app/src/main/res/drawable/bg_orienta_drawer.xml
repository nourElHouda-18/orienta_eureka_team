<?xml version="1.0" encoding="utf-8"?>
<!-- Side drawer: deep navy glass panel with a teal lower glow. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="300"
                android:centerColor="#FA0D1C5C"
                android:endColor="#FA0A5E6E"
                android:startColor="#FA04060F" />
            <corners
                android:bottomRightRadius="@dimen/orienta_radius_card"
                android:topRightRadius="@dimen/orienta_radius_card" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="@dimen/orienta_glass_stroke"
                android:color="@color/orienta_glass_border_soft" />
            <corners
                android:bottomRightRadius="@dimen/orienta_radius_card"
                android:topRightRadius="@dimen/orienta_radius_card" />
        </shape>
    </item>
</layer-list>
