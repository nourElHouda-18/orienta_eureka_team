    android:shape="oval">
    <gradient
        android:angle="315"
        android:endColor="@color/orienta_blue"
        android:startColor="@color/orienta_teal" />
    <stroke
        android:width="@dimen/orienta_glass_stroke"
        android:color="@color/orienta_glass_highlight" />
</shape>
