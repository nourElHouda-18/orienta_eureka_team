<?xml version="1.0" encoding="utf-8"?>
<!-- Round glass button background with ripple. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/orienta_glass_fill_pressed">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/orienta_glass_fill" />
            <stroke
                android:width="@dimen/orienta_glass_stroke"
                android:color="@color/orienta_glass_border" />
        </shape>
    </item>
</ripple>
