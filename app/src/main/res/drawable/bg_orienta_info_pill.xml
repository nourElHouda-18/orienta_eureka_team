<?xml version="1.0" encoding="utf-8"?>
<!-- Small glass pill for step labels, domain tags and value badges. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/orienta_glass_fill_strong" />
    <stroke
        android:width="@dimen/orienta_glass_stroke"
        android:color="@color/orienta_glass_border" />
    <corners android:radius="@dimen/orienta_radius_pill" />
</shape>
