<?xml version="1.0" encoding="utf-8"?>
<!-- Glass input for plain EditText / spinner containers: teal border when focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/orienta_glass_fill_strong" />
            <stroke
                android:width="1.5dp"
                android:color="@color/orienta_teal" />
            <corners android:radius="@dimen/orienta_radius_input" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/orienta_glass_fill" />
            <stroke
                android:width="@dimen/orienta_glass_stroke"
                android:color="@color/orienta_glass_border" />
            <corners android:radius="@dimen/orienta_radius_input" />
        </shape>
    </item>
</selector>
