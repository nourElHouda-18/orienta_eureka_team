<?xml version="1.0" encoding="utf-8"?>
<!-- Compact glass tile for a single statistic (feasibility, score). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/orienta_glass_fill_soft" />
    <stroke
        android:width="@dimen/orienta_glass_stroke"
        android:color="@color/orienta_glass_border_soft" />
    <corners android:radius="@dimen/orienta_radius_chip" />
</shape>
