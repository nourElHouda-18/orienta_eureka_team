<?xml version="1.0" encoding="utf-8"?>
<!-- Empty / placeholder container (also used from RecommendationActivity.showNoSubjectsMessage).
     Orienta glass style: dashed translucent border. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="@color/orienta_glass_fill_soft" />

    <stroke
        android:width="1dp"
        android:color="@color/orienta_glass_border"
        android:dashWidth="6dp"
        android:dashGap="4dp" />

    <corners android:radius="@dimen/orienta_radius_input" />

</shape>
