<?xml version="1.0" encoding="utf-8"?>
<!-- Window background for AppCompat / framework dialogs (glass-navy, 24dp corners). -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetBottom="16dp"
    android:insetLeft="16dp"
    android:insetRight="16dp"
    android:insetTop="16dp">
    <shape android:shape="rectangle">
        <gradient
            android:angle="270"
            android:endColor="@color/orienta_surface"
            android:startColor="@color/orienta_surface_high" />
        <stroke
            android:width="@dimen/orienta_glass_stroke"
            android:color="@color/orienta_glass_border" />
        <corners android:radius="@dimen/orienta_radius_card" />
    </shape>
</inset>
