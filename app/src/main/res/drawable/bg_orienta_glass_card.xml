<?xml version="1.0" encoding="utf-8"?>
<!-- Frosted glass surface: translucent white sheen, thin light border, 24dp corners. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Soft depth layer slightly below the card -->
    <item android:top="3dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/orienta_glass_shadow" />
            <corners android:radius="@dimen/orienta_radius_card" />
        </shape>
    </item>

    <item android:bottom="3dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="@color/orienta_glass_fill_soft"
                android:startColor="@color/orienta_glass_fill_strong" />
            <stroke
                android:width="@dimen/orienta_glass_stroke"
                android:color="@color/orienta_glass_border" />
            <corners android:radius="@dimen/orienta_radius_card" />
        </shape>
    </item>
</layer-list>
