<?xml version="1.0" encoding="utf-8"?>
<!-- Stronger glass pill used for floating menus (e.g. the avatar quick menu). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="#E6101B45"
        android:startColor="#E61A2B63" />
    <stroke
        android:width="@dimen/orienta_glass_stroke"
        android:color="@color/orienta_glass_highlight" />
    <corners android:radius="@dimen/orienta_radius_pill" />
</shape>
