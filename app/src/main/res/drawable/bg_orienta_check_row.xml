<?xml version="1.0" encoding="utf-8"?>
<!-- Selectable glass row (institution types, calculator options): teal tint when checked. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:endColor="@color/orienta_glass_fill"
                android:startColor="#3322CCD6" />
            <stroke
                android:width="@dimen/orienta_glass_stroke"
                android:color="#8022CCD6" />
            <corners android:radius="@dimen/orienta_radius_chip" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/orienta_glass_fill_soft" />
            <stroke
                android:width="@dimen/orienta_glass_stroke"
                android:color="@color/orienta_glass_border_soft" />
            <corners android:radius="@dimen/orienta_radius_chip" />
        </shape>
    </item>
</selector>
