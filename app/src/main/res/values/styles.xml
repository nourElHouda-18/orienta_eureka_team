<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
        ============================================================
        Orienta design system - typography
        Explicit Poppins weight files are used so the right weight
        renders on every API level (minSdk 24).
        ============================================================
    -->

    <style name="TextAppearance.Orienta.Display" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:textSize">@dimen/orienta_text_display</item>
        <item name="android:textColor">@color/orienta_text_primary</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="TextAppearance.Orienta.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:textSize">@dimen/orienta_text_headline</item>
        <item name="android:textColor">@color/orienta_text_primary</item>
    </style>

    <style name="TextAppearance.Orienta.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textSize">@dimen/orienta_text_title</item>
        <item name="android:textColor">@color/orienta_text_primary</item>
    </style>

    <style name="TextAppearance.Orienta.Subtitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:textSize">@dimen/orienta_text_subtitle</item>
        <item name="android:textColor">@color/orienta_text_secondary</item>
    </style>

    <style name="TextAppearance.Orienta.CardTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textSize">@dimen/orienta_text_subtitle</item>
        <item name="android:textColor">@color/orienta_text_primary</item>
        <item name="android:lineSpacingMultiplier">0.95</item>
    </style>

    <style name="TextAppearance.Orienta.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:textSize">@dimen/orienta_text_body</item>
        <item name="android:textColor">@color/orienta_text_primary</item>
    </style>

    <style name="TextAppearance.Orienta.Label" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textSize">@dimen/orienta_text_label</item>
        <item name="android:textColor">@color/orienta_text_primary</item>
    </style>

    <style name="TextAppearance.Orienta.Link" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textSize">@dimen/orienta_text_label</item>
        <item name="android:textColor">@color/orienta_teal_light</item>
    </style>

    <style name="TextAppearance.Orienta.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:textSize">@dimen/orienta_text_caption</item>
        <item name="android:textColor">@color/orienta_text_tertiary</item>
    </style>

    <style name="TextAppearance.Orienta.Overline" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textSize">@dimen/orienta_text_caption</item>
        <item name="android:textColor">@color/orienta_teal_light</item>
        <item name="android:letterSpacing">0.18</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="TextAppearance.Orienta.Button" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <!-- Material3 type-scale overrides so Material components also render in Poppins. -->
    <style name="TextAppearance.Orienta.M3.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.Orienta.M3.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.Orienta.M3.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.Orienta.M3.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
    </style>

    <style name="TextAppearance.Orienta.M3.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
    </style>

    <style name="TextAppearance.Orienta.M3.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
    </style>

    <style name="TextAppearance.Orienta.M3.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.Orienta.M3.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
    </style>

    <!--
        ============================================================
        Buttons
        ============================================================
    -->

    <!-- Teal -> blue gradient pill with a soft teal glow (glow colour on API 28+). -->
    <style name="Widget.Orienta.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:background">@drawable/bg_orienta_button_primary</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/orienta_text_on_accent</item>
        <item name="android:textAppearance">@style/TextAppearance.Orienta.Button</item>
        <item name="android:minHeight">@dimen/orienta_button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">@dimen/orienta_elevation_glow</item>
        <item name="android:outlineAmbientShadowColor" tools:targetApi="p">@color/orienta_teal</item>
        <item name="android:outlineSpotShadowColor" tools:targetApi="p">@color/orienta_teal</item>
        <item name="elevation">0dp</item>
    </style>

    <!-- Secondary glass pill (e.g. Continue with Google). -->
    <style name="Widget.Orienta.Button.Glass" parent="Widget.Material3.Button.OutlinedButton">
        <item name="backgroundTint">@color/orienta_glass_fill</item>
        <item name="strokeColor">@color/orienta_glass_border</item>
        <item name="strokeWidth">@dimen/orienta_glass_stroke</item>
        <item name="cornerRadius">@dimen/orienta_radius_pill</item>
        <item name="rippleColor">@color/orienta_glass_fill_pressed</item>
        <item name="android:textColor">@color/orienta_text_primary</item>
        <item name="android:textAppearance">@style/TextAppearance.Orienta.Button</item>
        <item name="android:minHeight">@dimen/orienta_button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.Orienta.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/orienta_teal_light</item>
        <item name="android:textAppearance">@style/TextAppearance.Orienta.Link</item>
        <item name="rippleColor">@color/orienta_glass_fill_pressed</item>
    </style>

    <!--
        ============================================================
        Glass text inputs
        ============================================================
    -->

    <style name="Widget.Orienta.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundMode">outline</item>
        <item name="boxBackgroundColor">@color/orienta_glass_fill</item>
        <item name="boxStrokeColor">@color/orienta_input_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">1.5dp</item>
        <item name="boxCornerRadiusTopStart">@dimen/orienta_radius_input</item>
        <item name="boxCornerRadiusTopEnd">@dimen/orienta_radius_input</item>
        <item name="boxCornerRadiusBottomStart">@dimen/orienta_radius_input</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/orienta_radius_input</item>
        <item name="hintTextColor">@color/orienta_teal_light</item>
        <item name="android:textColorHint">@color/orienta_input_hint</item>
        <item name="hintTextAppearance">@style/TextAppearance.Orienta.M3.BodySmall</item>
        <item name="startIconTint">@color/orienta_text_secondary</item>
        <item name="endIconTint">@color/orienta_text_secondary</item>
        <item name="errorTextColor">@color/orienta_error</item>
        <item name="errorIconTint">@color/orienta_error</item>
        <item name="boxStrokeErrorColor">@color/orienta_error</item>
        <item name="errorTextAppearance">@style/TextAppearance.Orienta.M3.BodySmall</item>
        <item name="materialThemeOverlay">@style/ThemeOverlay.Orienta.TextInputEditText</item>
    </style>

    <style name="Widget.Orienta.TextInputLayout.ExposedDropdown" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxBackgroundMode">outline</item>
        <item name="boxBackgroundColor">@color/orienta_glass_fill</item>
        <item name="boxStrokeColor">@color/orienta_input_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">1.5dp</item>
        <item name="boxCornerRadiusTopStart">@dimen/orienta_radius_input</item>
        <item name="boxCornerRadiusTopEnd">@dimen/orienta_radius_input</item>
        <item name="boxCornerRadiusBottomStart">@dimen/orienta_radius_input</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/orienta_radius_input</item>
        <item name="hintTextColor">@color/orienta_teal_light</item>
        <item name="android:textColorHint">@color/orienta_input_hint</item>
        <item name="startIconTint">@color/orienta_text_secondary</item>
        <item name="endIconTint">@color/orienta_text_secondary</item>
        <item name="errorTextColor">@color/orienta_error</item>
        <item name="boxStrokeErrorColor">@color/orienta_error</item>
    </style>

    <style name="ThemeOverlay.Orienta.TextInputEditText" parent="ThemeOverlay.Material3.TextInputEditText.OutlinedBox">
        <item name="editTextStyle">@style/Widget.Orienta.TextInputEditText</item>
    </style>

    <style name="Widget.Orienta.TextInputEditText" parent="Widget.Material3.TextInputEditText.OutlinedBox">
        <item name="android:textColor">@color/orienta_text_primary</item>
        <item name="android:textAppearance">@style/TextAppearance.Orienta.Body</item>
        <item name="android:minHeight">@dimen/orienta_input_min_height</item>
    </style>

    <!--
        ============================================================
        Selection controls and surfaces
        ============================================================
    -->

    <style name="Widget.Orienta.CheckBox" parent="Widget.Material3.CompoundButton.CheckBox">
        <item name="buttonTint">@color/orienta_checkbox_tint</item>
        <item name="android:textColor">@color/orienta_text_secondary</item>
        <item name="android:textAppearance">@style/TextAppearance.Orienta.Label</item>
    </style>

    <!-- Glass card (MaterialCardView ignores android:background, so the glass look comes from these attributes). -->
    <style name="Widget.Orienta.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/orienta_glass_fill</item>
        <item name="strokeColor">@color/orienta_glass_border</item>
        <item name="strokeWidth">@dimen/orienta_glass_stroke</item>
        <item name="cardCornerRadius">@dimen/orienta_radius_card</item>
        <item name="cardElevation">@dimen/orienta_elevation_none</item>
        <item name="rippleColor">@color/orienta_glass_fill_strong</item>
    </style>

    <!-- Circular crop for the profile photo. -->
    <style name="ShapeAppearance.Orienta.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Round glass icon button (menu, back). -->
    <style name="Widget.Orienta.IconButton" parent="">
        <item name="android:layout_width">@dimen/orienta_icon_button</item>
        <item name="android:layout_height">@dimen/orienta_icon_button</item>
        <item name="android:background">@drawable/bg_orienta_glass_circle</item>
        <item name="android:padding">11dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="tint">@color/orienta_text_primary</item>
    </style>

    <!-- Screen header (title + subtitle over the gradient). -->
    <style name="TextAppearance.Orienta.ScreenTitle" parent="TextAppearance.Orienta.Headline">
        <item name="android:textSize">24sp</item>
    </style>

    <!-- Section heading inside a glass card. -->
    <style name="TextAppearance.Orienta.Section" parent="TextAppearance.Orienta.Title">
        <item name="android:textSize">17sp</item>
    </style>

    <!-- Plain EditText rendered as a glass input. -->
    <style name="Widget.Orienta.EditText.Glass" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/bg_orienta_glass_input</item>
        <item name="android:textColor">@color/orienta_text_primary</item>
        <item name="android:textColorHint">@color/orienta_text_hint</item>
        <item name="android:textAppearance">@style/TextAppearance.Orienta.Body</item>
        <item name="android:paddingStart">@dimen/orienta_space_m</item>
        <item name="android:paddingEnd">@dimen/orienta_space_m</item>
        <item name="android:minHeight">@dimen/orienta_input_min_height</item>
    </style>

    <!-- Spinner: the glass container is drawn by the parent; the popup is navy glass. -->
    <style name="Widget.Orienta.Spinner" parent="Widget.AppCompat.Spinner">
        <item name="android:popupBackground">@drawable/bg_orienta_popup</item>
        <item name="android:dropDownVerticalOffset">6dp</item>
        <item name="android:popupElevation">8dp</item>
    </style>

    <style name="Widget.Orienta.AutoCompleteTextView" parent="Widget.AppCompat.AutoCompleteTextView">
        <item name="android:popupBackground">@drawable/bg_orienta_popup</item>
    </style>

    <!-- RIASEC 1-5 score chip (RadioButton). -->
    <style name="Widget.Orienta.RadioChip" parent="Widget.AppCompat.CompoundButton.RadioButton">
        <item name="android:button">@null</item>
        <item name="buttonCompat">@null</item>
        <item name="android:background">@drawable/bg_orienta_score_chip</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/orienta_score_text</item>
        <item name="android:textAppearance">@style/TextAppearance.Orienta.Title</item>
        <item name="android:textSize">18sp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
    </style>

    <!-- Glass selectable row (institution types, calculator options). -->
    <style name="Widget.Orienta.CheckBox.Row" parent="Widget.Orienta.CheckBox">
        <item name="android:background">@drawable/bg_orienta_check_row</item>
        <item name="android:textColor">@color/orienta_text_primary</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">@dimen/orienta_space_xs</item>
        <item name="android:paddingEnd">@dimen/orienta_space_m</item>
    </style>

    <style name="Widget.Orienta.ProgressBar.Gradient" parent="Widget.AppCompat.ProgressBar.Horizontal">
        <item name="android:progressDrawable">@drawable/bg_orienta_progress</item>
        <item name="android:minHeight">8dp</item>
        <item name="android:maxHeight">8dp</item>
        <item name="android:max">100</item>
        <item name="android:indeterminate">false</item>
    </style>

    <style name="Widget.Orienta.ProgressBar.Circular" parent="Widget.AppCompat.ProgressBar">
        <item name="android:indeterminateTint">@color/orienta_teal</item>
    </style>

    <style name="Widget.Orienta.RatingBar" parent="Widget.AppCompat.RatingBar">
        <item name="android:progressTint">@color/orienta_teal</item>
        <item name="android:secondaryProgressTint">@color/orienta_teal</item>
        <item name="android:progressBackgroundTint">@color/orienta_glass_highlight</item>
    </style>

    <!--
        ============================================================
        Dialogs
        ============================================================
    -->

    <!-- MaterialAlertDialogBuilder dialogs. -->
    <style name="ThemeOverlay.Orienta.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/orienta_surface_high</item>
        <item name="colorSurfaceContainerHigh">@color/orienta_surface_high</item>
        <item name="colorOnSurface">@color/orienta_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/orienta_text_secondary</item>
        <item name="colorPrimary">@color/orienta_teal</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.Orienta.Dialog</item>
        <item name="materialAlertDialogTitleTextStyle">@style/MaterialAlertDialog.Orienta.Title</item>
        <item name="materialAlertDialogBodyTextStyle">@style/MaterialAlertDialog.Orienta.Body</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Orienta.Button.Dialog</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Orienta.Button.Dialog</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.Orienta.Button.Dialog</item>
    </style>

    <style name="ShapeAppearance.Orienta.Dialog" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerSize">@dimen/orienta_radius_card</item>
    </style>

    <style name="MaterialAlertDialog.Orienta.Title" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textAppearance">@style/TextAppearance.Orienta.Title</item>
        <item name="android:textColor">@color/orienta_text_primary</item>
    </style>

    <style name="MaterialAlertDialog.Orienta.Body" parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="android:textAppearance">@style/TextAppearance.Orienta.Body</item>
        <item name="android:textColor">@color/orienta_text_secondary</item>
    </style>

    <style name="Widget.Orienta.Button.Dialog" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/orienta_teal_light</item>
        <item name="android:textAppearance">@style/TextAppearance.Orienta.Link</item>
        <item name="rippleColor">@color/orienta_glass_fill_pressed</item>
    </style>

    <!-- androidx.appcompat AlertDialog.Builder dialogs. -->
    <style name="ThemeOverlay.Orienta.AlertDialog" parent="ThemeOverlay.Material3.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_orienta_dialog</item>
        <item name="colorPrimary">@color/orienta_teal</item>
        <item name="colorAccent">@color/orienta_teal</item>
        <item name="colorSurface">@color/orienta_surface_high</item>
        <item name="colorOnSurface">@color/orienta_text_primary</item>
        <item name="android:textColorPrimary">@color/orienta_text_primary</item>
        <item name="android:textColorSecondary">@color/orienta_text_secondary</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Orienta.Button.Dialog</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Orienta.Button.Dialog</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.Orienta.Button.Dialog</item>
    </style>

    <!-- Framework DatePickerDialog (Profile date of birth). -->
    <style name="ThemeOverlay.Orienta.DatePicker" parent="ThemeOverlay.Material3.Dialog">
        <item name="android:windowBackground">@drawable/bg_orienta_dialog</item>
        <item name="android:colorAccent">@color/orienta_teal</item>
        <item name="colorAccent">@color/orienta_teal</item>
        <item name="android:colorPrimary">@color/orienta_blue_deep</item>
        <item name="colorPrimary">@color/orienta_teal</item>
        <item name="android:textColorPrimary">@color/orienta_text_primary</item>
        <item name="android:textColorSecondary">@color/orienta_text_secondary</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:datePickerStyle">@style/Widget.Orienta.DatePicker</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Orienta.Button.Dialog</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Orienta.Button.Dialog</item>
    </style>

    <style name="Widget.Orienta.DatePicker" parent="@android:style/Widget.Material.DatePicker">
        <item name="android:headerBackground">@color/orienta_blue_deep</item>
    </style>

</resources>
